# ============================================================
# HADES OMEGA — .gitignore
# Nunca commitear secretos, credenciales ni bases de datos
# ============================================================

# ── Variables de entorno ─────────────────────────────────────
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
.env.*.local

# ── Credenciales NEAR ────────────────────────────────────────
# Las claves NEAR se almacenan en ~/.near-credentials/
# NUNCA incluir archivos de claves en el repositorio
*.key
*.pem
*.near-credentials
near-credentials/
.near-credentials/
**/testnet/*.json
**/mainnet/*.json

# ── Dependencias ─────────────────────────────────────────────
node_modules/
.pnpm-store/

# ── Compilación TypeScript ───────────────────────────────────
dist/
build/
*.tsbuildinfo
.turbo/

# ── Compilación Rust / NEAR contracts ────────────────────────
target/
# Cargo.lock se mantiene para contratos NEAR (binarios); descomentar abajo si se agrega una librería Rust pura:
# Cargo.lock

# ── Base de datos local ───────────────────────────────────────
*.db
*.sqlite
*.sqlite3
data/
*.db-journal
*.db-shm
*.db-wal

# ── Logs ─────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*

# ── Tests y cobertura ─────────────────────────────────────────
coverage/
.nyc_output/
test-results/
playwright-report/
playwright/.cache/

# ── Frontend build ────────────────────────────────────────────
.next/
.nuxt/
.vite/
.svelte-kit/

# ── IDEs ──────────────────────────────────────────────────────
.vscode/settings.json
.vscode/launch.json
.idea/
*.suo
*.user

# ── Sistema operativo ─────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# ── Archivos temporales ───────────────────────────────────────
*.tmp
*.temp
*.bak
*.swp
*~

# ── Vercel ────────────────────────────────────────────────────
.vercel

# ── Archivos de auditoría local (no son secretos pero son grandes)
# audit-export-*.json

.vercel

# SQLite journals and legacy migration backups
*.sqlite-wal
*.sqlite-shm
*.json.backup-*

# ── Scripts de desarrollo local (no incorporar — pueden contener credenciales) ──
scripts/init-live-db.cjs
scripts/run-live-demo.cjs
scripts/sqlite-check.cjs
scripts/start-api-daemon.cjs
scripts/start-frontend-daemon.cjs
scripts/check-webgl-v10.cjs
scripts/check-webgl-v10-integration.cjs
scripts/e2e-v10-review.cjs

# ── Archivos locales no rastreados (respaldos, evidencias, temporales) ─────────
recovery-*/
evidence-*/
integration-v10-temp/
.test-tmp/
ESTRATEGIA_INTEGRACION_SEGURA_V10.md
INFORME_INTEGRACION_V10.md
