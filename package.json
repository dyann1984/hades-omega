{
  "name": "hades-omega",
  "version": "0.3.0",
  "private": true,
  "packageManager": "npm@10.9.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test:e2e": "playwright test",
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "dev:api": "turbo dev --filter=@hades/api",
    "dev:frontend": "turbo dev --filter=@hades/frontend",
    "dev:all": "concurrently \"npm run dev:api\" \"npm run dev:frontend\"",
    "test:all": "turbo test --parallel"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.9.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "turbo": "^2.3.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.3.7"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
