{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "hades-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--workspace=packages/frontend", "--", "--port", "5180", "--strictPort"],
      "port": 5180,
      "url": "http://127.0.0.1:5180"
    },
    {
      "name": "hades-prod-build-vs-render",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "set HADES_PROXY_TARGET=https://hades-omega.onrender.com&& npm run preview --workspace=packages/frontend -- --port 5181 --strictPort"],
      "port": 5181,
      "url": "http://127.0.0.1:5181"
    }
  ]
}
