# ============================================================
# HADES OMEGA â€” Variables de entorno
# Copia este archivo como .env y completa los valores reales.
# NUNCA commitear .env con valores reales.
# Todas las claves de API y NEAR son SERVER-SIDE Ãºnicamente.
# ============================================================

# â”€â”€ Entorno â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
NODE_ENV=development
API_PORT=3001

# â”€â”€ AutenticaciÃ³n JWT (servidor) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Generar con: openssl rand -hex 64
JWT_SECRET=REEMPLAZAR_CON_SECRETO_GENERADO_LOCALMENTE
JWT_EXPIRES_IN=8h

# â”€â”€ Anthropic Claude API (servidor â€” jamÃ¡s exponer al cliente) â”€
# Obtener en: https://console.anthropic.com
ANTHROPIC_API_KEY=REEMPLAZAR_CON_TU_API_KEY
ANTHROPIC_MODEL=claude-opus-4-5

# â”€â”€ Base de datos â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
DATABASE_URL=./data/hades.db
# Ruta del repositorio duradero local. En entornos serverless se requiere un
# adaptador de base de datos externo; el filesystem efÃ­mero no es vÃ¡lido.
HADES_DATA_FILE=./data/hades.json
ALLOWED_ORIGIN=http://localhost:5173
DATABASE_MIGRATIONS_DIR=./packages/core/src/db/migrations

# â”€â”€ NEAR Testnet â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# La cuenta se crea en: https://wallet.testnet.near.org
# Las credenciales se almacenan en: ~/.near-credentials/
# NUNCA poner claves privadas aquÃ­
NEAR_NETWORK=testnet
NEAR_ACCOUNT_ID=REEMPLAZAR_CON_CUENTA_NEAR_TESTNET
NEAR_CONTRACT_ID=REEMPLAZAR_CON_ID_DEL_CONTRATO_AUDITORIA
NEAR_CREDENTIALS_PATH=~/.near-credentials

# Modo de ejecuciÃ³n NEAR:
# "simulation" â†’ escribe en SQLite local, nunca llama a NEAR (default en dev)
# "real"       â†’ envÃ­a transacciones reales a testnet (solo para demo)
NEAR_EXECUTION_MODE=simulation

# â”€â”€ Motor CERBERUS â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
CERBERUS_POLICY_PATH=./policies/default.json
CERBERUS_AUDIT_DB=./data/audit.db
CERBERUS_NEAR_ENABLED=false

# Umbrales de contenciÃ³n (en ms y nÃºmero de eventos)
CERBERUS_BLOCK_THRESHOLD=3
CERBERUS_BLOCK_WINDOW_MS=300000
CERBERUS_QUARANTINE_THRESHOLD=5
CERBERUS_BLOCK_DURATION_MS=600000

# â”€â”€ Frontend (variables VITE_* son pÃºblicas â€” solo valores no sensibles) â”€
# NO poner claves de API aquÃ­
VITE_API_URL=http://localhost:3001
VITE_WS_URL=ws://localhost:3001/ws
VITE_APP_ENV=development
