# ============================================================
# HADES OMEGA — Variables de entorno
# Copia este archivo como .env y completa los valores reales.
# NUNCA commitear .env con valores reales.
# Todas las claves de API y NEAR son SERVER-SIDE únicamente.
# ============================================================

# ── Entorno ──────────────────────────────────────────────────
NODE_ENV=development
API_PORT=3001

# ── Autenticación JWT (servidor) ─────────────────────────────
# Generar con: openssl rand -hex 64
JWT_SECRET=REEMPLAZAR_CON_SECRETO_GENERADO_LOCALMENTE
JWT_EXPIRES_IN=8h

# ── Anthropic Claude API (servidor — jamás exponer al cliente) ─
# Obtener en: https://console.anthropic.com
ANTHROPIC_API_KEY=REEMPLAZAR_CON_TU_API_KEY
ANTHROPIC_MODEL=claude-opus-4-5

# ── Base de datos ─────────────────────────────────────────────
DATABASE_URL=./data/hades.db
# Ruta del repositorio duradero local. En entornos serverless se requiere un
# adaptador de base de datos externo; el filesystem efímero no es válido.
HADES_DATA_FILE=./data/hades.json
ALLOWED_ORIGIN=http://127.0.0.1:5174
DATABASE_MIGRATIONS_DIR=./packages/core/src/db/migrations

# ── NEAR Testnet ──────────────────────────────────────────────
# La cuenta se crea en: https://wallet.testnet.near.org
# Las credenciales se almacenan en: ~/.near-credentials/
# NUNCA poner claves privadas aquí
NEAR_NETWORK=testnet
NEAR_ACCOUNT_ID=REEMPLAZAR_CON_CUENTA_NEAR_TESTNET
NEAR_CONTRACT_ID=REEMPLAZAR_CON_ID_DEL_CONTRATO_AUDITORIA
NEAR_CREDENTIALS_PATH=~/.near-credentials

# Modo de ejecución NEAR:
# "simulation" → escribe en SQLite local, nunca llama a NEAR (default en dev)
# "real"       → envía transacciones reales a testnet (solo para demo)
NEAR_EXECUTION_MODE=simulation

# ── Motor CERBERUS ────────────────────────────────────────────
CERBERUS_POLICY_PATH=./policies/default.json
CERBERUS_AUDIT_DB=./data/audit.db
CERBERUS_NEAR_ENABLED=false

# Umbrales de contención (en ms y número de eventos)
CERBERUS_BLOCK_THRESHOLD=3
CERBERUS_BLOCK_WINDOW_MS=300000
CERBERUS_QUARANTINE_THRESHOLD=5
CERBERUS_BLOCK_DURATION_MS=600000

# ── Frontend (variables VITE_* son públicas — solo valores no sensibles) ─
# NO poner claves de API aquí
VITE_API_URL=http://localhost:3001
VITE_WS_URL=ws://localhost:3001/ws
VITE_APP_ENV=development

# -- Persistencia durable (OPCIONAL, solo servidor; nunca en el frontend ni en Git) --
# Cadena PostgreSQL (Neon) con TLS obligatorio: postgres://USUARIO:CLAVE@HOST/DB?sslmode=require
# HADES_DURABLE_DATABASE_URL=
# Clave de cifrado del snapshot (>=32 caracteres aleatorios, distinta de JWT_SECRET)
# HADES_SNAPSHOT_KEY=

# Vault opcional: clave externa de 32 bytes aleatorios en base64 canónico; no subir el valor a Git.
# HADES_VAULT_MASTER_KEY=
# Selección opcional de la clave NEAR desde Vault; no habilita firma ni envíos.
# HADES_NEAR_KEY_SOURCE=vault
